<turbo-frame id="aws-s3-list-frame">
    <div class="mb-3 count text-black dark:text-white">
        {{ pagination.getTotalItemCount }} bucket(s) S3 trouvé(s)
    </div>

    <div class="mb-5">
        {% import '_macro/_table_columns_display.html.twig' as macro %}

        {% set columns = [
            { 'label': 'Bucket Name', 'cssClass': 'bucket-name', checked: true },
            { 'label': 'Region', 'cssClass': 'region', checked: true },
            { 'label': 'Encryption', 'cssClass': 'encryption', checked: true },
            { 'label': 'Versioning', 'cssClass': 'versioning', checked: true },
            { 'label': 'Created', 'cssClass': 'creation-date', checked: true }
        ] %}

        {{ form_start(searchForm, {action: path(app.current_route)}) }}

        <div class="grid grid-cols-4 gap-4 items-end">
            {{ form_row(searchForm.name) }}
            {{ form_row(searchForm.region) }}
            {{ form_row(searchForm.versioningStatus) }}
            {{ form_row(searchForm.encryptionEnabled) }}
        </div>

        {% for key, value in app.request.query.all %}
            {% if searchForm[key] is not defined %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
        {% endfor %}

        <div class="flex gap-4 justify-between">
            <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                Rechercher
            </button>
            <div class="gap-4">
                {{ macro.dropdownTableColumsDisplay(columns) }}
                <a href="{{ path('app_aws_s3_list_export', app.request.query.all) }}" class="text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
                    Exporter
                </a>
            </div>
        </div>
        {{ form_end(searchForm) }}
    </div>

    <div class="relative overflow-x-auto">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="px-6 py-3 column-bucket-name">{{ knp_pagination_sortable(pagination, 'Bucket Name', 's3.name', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-region">{{ knp_pagination_sortable(pagination, 'Region', 's3.region', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-encryption">Encryption</th>
                <th scope="col" class="px-6 py-3 column-versioning">{{ knp_pagination_sortable(pagination, 'Versioning', 's3.versioningStatus', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-creation-date">{{ knp_pagination_sortable(pagination, 'Created', 's3.creationDate', [], app.request.query.all) }}</th>
            </tr>
            </thead>
            <tbody>
            {% for bucket in pagination %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 border-gray-200">
                    <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white column-bucket-name">
                        {{ bucket.name }}
                    </th>
                    <td class="px-6 py-4 column-region">
                        {% if bucket.region %}
                            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                                {{ bucket.region }}
                            </span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-encryption">
                        {% if bucket.encryptionEnabled %}
                            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">Yes</span>
                        {% else %}
                            <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">No</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-versioning">
                        {% if bucket.versioningStatus == 'Enabled' %}
                            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">
                                {{ bucket.versioningStatus }}
                            </span>
                        {% elseif bucket.versioningStatus == 'Suspended' %}
                            <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">
                                {{ bucket.versioningStatus }}
                            </span>
                        {% else %}
                            <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-900 dark:text-gray-300">
                                Disabled
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-creation-date">
                        {% if bucket.creationDate %}
                            {{ bucket.creationDate|date('d/m/Y H:i:s') }}
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                        Aucun bucket S3 trouvé
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="mt-5 flex justify-end">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
</turbo-frame>
