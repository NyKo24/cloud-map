<turbo-frame id="aws-ec2-list-frame">
    <div class="mb-3 count text-black dark:text-white">
        {{ pagination.getTotalItemCount }} instance(s) EC2 trouvée(s)
    </div>

    <div class="mb-5">
        {% import '_macro/_table_columns_display.html.twig' as macro %}

        {% set columns = [
            { 'label': 'Instance ID', 'cssClass': 'instance-id', checked: true },
            { 'label': 'Name', 'cssClass': 'name', checked: true },
            { 'label': 'Instance Type', 'cssClass': 'instance-type', checked: true },
            { 'label': 'State', 'cssClass': 'state', checked: true },
            { 'label': 'Architecture', 'cssClass': 'architecture', checked: true },
            { 'label': 'Private IP', 'cssClass': 'private-ip', checked: true },
            { 'label': 'Public IP', 'cssClass': 'public-ip', checked: true },
            { 'label': 'VPC ID', 'cssClass': 'vpc-id', checked: true },
            { 'label': 'Launch Time', 'cssClass': 'launch-time', checked: true }
        ] %}

        {{ form_start(searchForm, {action: path(app.current_route)}) }}

        <div class="grid grid-cols-5 gap-4 items-end">
            {{ form_row(searchForm.instanceId) }}
            {{ form_row(searchForm.instanceType) }}
            {{ form_row(searchForm.state) }}
            {{ form_row(searchForm.vpcId) }}
            {{ form_row(searchForm.architecture) }}
        </div>

        {% for key, value in app.request.query.all %}
            {% if searchForm[key] is not defined %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
        {% endfor %}

        <div class="flex gap-4 justify-between">
            <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                Rechercher
            </button>
            <div class="gap-4">
                {{ macro.dropdownTableColumsDisplay(columns) }}
                <a href="{{ path('app_aws_ec2_list_export', app.request.query.all) }}" class="text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
                    Exporter
                </a>
            </div>
        </div>
        {{ form_end(searchForm) }}
    </div>

    <div class="relative overflow-x-auto">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="px-6 py-3 column-instance-id">{{ knp_pagination_sortable(pagination, 'Instance ID', 'ei.instanceId', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-name">Name</th>
                <th scope="col" class="px-6 py-3 column-instance-type">{{ knp_pagination_sortable(pagination, 'Instance Type', 'ei.instanceType', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-state">State</th>
                <th scope="col" class="px-6 py-3 column-architecture">{{ knp_pagination_sortable(pagination, 'Architecture', 'ei.architecture', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-private-ip">{{ knp_pagination_sortable(pagination, 'Private IP', 'ei.privateIpAddress', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-public-ip">{{ knp_pagination_sortable(pagination, 'Public IP', 'ei.publicIpAddress', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-vpc-id">{{ knp_pagination_sortable(pagination, 'VPC ID', 'ei.vpcId', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-launch-time">{{ knp_pagination_sortable(pagination, 'Launch Time', 'ei.launchTime', [], app.request.query.all) }}</th>
            </tr>
            </thead>
            <tbody>
            {% for instance in pagination %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 border-gray-200">
                    <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white column-instance-id">
                        {{ instance.instanceId }}
                    </th>
                    <td class="px-6 py-4 column-name">
                        {% if instance.nameTag %}
                            {{ instance.nameTag }}
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-instance-type">
                        {% if instance.instanceType %}
                            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                                {{ instance.instanceType }}
                            </span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-state">
                        {% if instance.stateName %}
                            {% if instance.stateName == 'running' %}
                                {% set stateColor = 'green' %}
                            {% elseif instance.stateName == 'stopped' %}
                                {% set stateColor = 'red' %}
                            {% elseif instance.stateName == 'terminated' %}
                                {% set stateColor = 'gray' %}
                            {% else %}
                                {% set stateColor = 'yellow' %}
                            {% endif %}
                            <span class="bg-{{ stateColor }}-100 text-{{ stateColor }}-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-{{ stateColor }}-900 dark:text-{{ stateColor }}-300">
                                {{ instance.stateName }}
                            </span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-architecture">
                        {% if instance.architecture %}
                            <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-purple-900 dark:text-purple-300">
                                {{ instance.architecture }}
                            </span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-private-ip">
                        {% if instance.privateIpAddress %}
                            {{ instance.privateIpAddress }}
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-public-ip">
                        {% if instance.publicIpAddress %}
                            {{ instance.publicIpAddress }}
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-vpc-id">
                        {% if instance.vpcId %}
                            {{ instance.vpcId }}
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-launch-time">
                        {% if instance.launchTime %}
                            {{ instance.launchTime|date('d/m/Y H:i:s') }}
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                        Aucune instance EC2 trouvée
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="mt-5 flex justify-end">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
</turbo-frame>
