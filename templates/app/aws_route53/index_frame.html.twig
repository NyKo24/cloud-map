<turbo-frame id="aws-route53-list-frame">
    <div class="mb-3 count text-black dark:text-white">
        {{ pagination.getTotalItemCount }} hosted zone(s) Route53 trouvé(s)
    </div>

    <div class="mb-5">
        {% import '_macro/_table_columns_display.html.twig' as macro %}

        {% set columns = [
            { 'label': 'Zone Name', 'cssClass': 'zone-name', checked: true },
            { 'label': 'Hosted Zone ID', 'cssClass': 'hosted-zone-id', checked: true },
            { 'label': 'Type', 'cssClass': 'type', checked: true },
            { 'label': 'Record Count', 'cssClass': 'record-count', checked: true },
            { 'label': 'Comment', 'cssClass': 'comment', checked: true },
            { 'label': 'Caller Reference', 'cssClass': 'caller-reference', checked: false }
        ] %}

        {{ form_start(searchForm, {action: path(app.current_route)}) }}

        <div class="grid grid-cols-3 gap-4 items-end">
            {{ form_row(searchForm.name) }}
            {{ form_row(searchForm.hostedZoneId) }}
            {{ form_row(searchForm.privateZone) }}
        </div>

        {% for key, value in app.request.query.all %}
            {% if searchForm[key] is not defined %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
        {% endfor %}

        <div class="flex gap-4 justify-between">
            <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                Rechercher
            </button>
            <div class="gap-4">
                {{ macro.dropdownTableColumsDisplay(columns) }}
                <a href="{{ path('app_aws_route53_list_export', app.request.query.all) }}" class="text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
                    Exporter
                </a>
            </div>
        </div>
        {{ form_end(searchForm) }}
    </div>

    <div class="relative overflow-x-auto">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="px-6 py-3 column-zone-name">{{ knp_pagination_sortable(pagination, 'Zone Name', 'hz.name', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-hosted-zone-id">{{ knp_pagination_sortable(pagination, 'Hosted Zone ID', 'hz.hostedZoneId', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-type">Type</th>
                <th scope="col" class="px-6 py-3 column-record-count">{{ knp_pagination_sortable(pagination, 'Record Count', 'hz.resourceRecordSetCount', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-comment">Comment</th>
                <th scope="col" class="px-6 py-3 column-caller-reference">Caller Reference</th>
            </tr>
            </thead>
            <tbody>
            {% for zone in pagination %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 border-gray-200">
                    <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white column-zone-name">
                        {{ zone.name }}
                    </th>
                    <td class="px-6 py-4 column-hosted-zone-id">
                        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                            {{ zone.hostedZoneId }}
                        </span>
                    </td>
                    <td class="px-6 py-4 column-type">
                        {% if zone.privateZone %}
                            <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-purple-900 dark:text-purple-300">Private</span>
                        {% else %}
                            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">Public</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-record-count">
                        {{ zone.resourceRecordSetCount ?? '-' }}
                    </td>
                    <td class="px-6 py-4 column-comment">
                        {% if zone.comment %}
                            {{ zone.comment }}
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-caller-reference">
                        {% if zone.callerReference %}
                            <span class="text-xs text-gray-500 dark:text-gray-400">{{ zone.callerReference }}</span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                        Aucune hosted zone Route53 trouvée
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="mt-5 flex justify-end">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
</turbo-frame>
