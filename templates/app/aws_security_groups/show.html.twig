{% extends 'base.html.twig' %}

{% block title %}Security Group - {{ securityGroup.groupId }}{% endblock %}

{% block body %}
    <div class="mb-4">
        <a href="{{ path('app_aws_security_groups_list') }}" class="text-blue-600 hover:underline dark:text-blue-400">
            &larr; Retour à la liste
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">{{ securityGroup.groupName }}</h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div>
                <span class="text-xs text-gray-500 dark:text-gray-400">Group ID</span>
                <p class="text-sm font-medium text-gray-900 dark:text-white">{{ securityGroup.groupId }}</p>
            </div>
            <div>
                <span class="text-xs text-gray-500 dark:text-gray-400">VPC ID</span>
                <p class="text-sm font-medium text-gray-900 dark:text-white">{{ securityGroup.vpcId ?? '-' }}</p>
            </div>
            <div>
                <span class="text-xs text-gray-500 dark:text-gray-400">Owner ID</span>
                <p class="text-sm font-medium text-gray-900 dark:text-white">{{ securityGroup.ownerId ?? '-' }}</p>
            </div>
            <div>
                <span class="text-xs text-gray-500 dark:text-gray-400">Description</span>
                <p class="text-sm font-medium text-gray-900 dark:text-white">{{ securityGroup.description ?? '-' }}</p>
            </div>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 mb-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Ingress Rules
            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300 ml-2">
                {{ securityGroup.ingressRules|length }}
            </span>
        </h3>

        <div class="relative overflow-x-auto">
            <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th scope="col" class="px-6 py-3">Protocol</th>
                    <th scope="col" class="px-6 py-3">Port Range</th>
                    <th scope="col" class="px-6 py-3">Source</th>
                </tr>
                </thead>
                <tbody>
                {% for rule in securityGroup.ingressRules %}
                    <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 border-gray-200">
                        <td class="px-6 py-4">
                            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                                {{ rule.ipProtocol == '-1' ? 'All' : rule.ipProtocol }}
                            </span>
                        </td>
                        <td class="px-6 py-4">{{ rule.portRange }}</td>
                        <td class="px-6 py-4">
                            {% if rule.cidrIp %}
                                {{ rule.cidrIp }}
                            {% elseif rule.cidrIpv6 %}
                                {{ rule.cidrIpv6 }}
                            {% else %}
                                <span class="text-gray-400">-</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                            Aucune règle d'entrée
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Egress Rules
            <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300 ml-2">
                {{ securityGroup.egressRules|length }}
            </span>
        </h3>

        <div class="relative overflow-x-auto">
            <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th scope="col" class="px-6 py-3">Protocol</th>
                    <th scope="col" class="px-6 py-3">Port Range</th>
                    <th scope="col" class="px-6 py-3">Destination</th>
                </tr>
                </thead>
                <tbody>
                {% for rule in securityGroup.egressRules %}
                    <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 border-gray-200">
                        <td class="px-6 py-4">
                            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                                {{ rule.ipProtocol == '-1' ? 'All' : rule.ipProtocol }}
                            </span>
                        </td>
                        <td class="px-6 py-4">{{ rule.portRange }}</td>
                        <td class="px-6 py-4">
                            {% if rule.cidrIp %}
                                {{ rule.cidrIp }}
                            {% elseif rule.cidrIpv6 %}
                                {{ rule.cidrIpv6 }}
                            {% else %}
                                <span class="text-gray-400">-</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                            Aucune règle de sortie
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
