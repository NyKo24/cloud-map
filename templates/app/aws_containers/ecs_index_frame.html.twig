<turbo-frame id="aws-ecs-clusters-list-frame">
    <div class="mb-3 count text-black dark:text-white">
        {{ pagination.getTotalItemCount }} cluster(s) ECS trouvé(s)
    </div>

    <div class="mb-5">
        {% import '_macro/_table_columns_display.html.twig' as macro %}

        {% set columns = [
            { 'label': 'Cluster Name', 'cssClass': 'cluster-name', checked: true },
            { 'label': 'Status', 'cssClass': 'status', checked: true },
            { 'label': 'Container Instances', 'cssClass': 'container-instances', checked: true },
            { 'label': 'Running Tasks', 'cssClass': 'running-tasks', checked: true },
            { 'label': 'Active Services', 'cssClass': 'active-services', checked: true },
            { 'label': 'Cluster ARN', 'cssClass': 'cluster-arn', checked: false }
        ] %}

        {{ form_start(searchForm, {action: path(app.current_route)}) }}

        <div class="grid grid-cols-2 gap-4 items-end">
            {{ form_row(searchForm.clusterName) }}
            {{ form_row(searchForm.status) }}
        </div>

        {% for key, value in app.request.query.all %}
            {% if searchForm[key] is not defined %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
        {% endfor %}

        <div class="flex gap-4 justify-between">
            <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                Rechercher
            </button>
            <div class="gap-4">
                {{ macro.dropdownTableColumsDisplay(columns) }}
                <a href="{{ path('app_aws_ecs_clusters_list_export', app.request.query.all) }}" class="text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
                    Exporter
                </a>
            </div>
        </div>
        {{ form_end(searchForm) }}
    </div>

    <div class="relative overflow-x-auto">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="px-6 py-3 column-cluster-name">{{ knp_pagination_sortable(pagination, 'Cluster Name', 'ecs.clusterName', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-status">{{ knp_pagination_sortable(pagination, 'Status', 'ecs.status', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-container-instances">{{ knp_pagination_sortable(pagination, 'Container Instances', 'ecs.registeredContainerInstancesCount', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-running-tasks">{{ knp_pagination_sortable(pagination, 'Running Tasks', 'ecs.runningTasksCount', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-active-services">{{ knp_pagination_sortable(pagination, 'Active Services', 'ecs.activeServicesCount', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-cluster-arn">Cluster ARN</th>
            </tr>
            </thead>
            <tbody>
            {% for cluster in pagination %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 border-gray-200">
                    <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white column-cluster-name">
                        {{ cluster.clusterName }}
                    </th>
                    <td class="px-6 py-4 column-status">
                        {% if cluster.status == 'ACTIVE' %}
                            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">
                                {{ cluster.status }}
                            </span>
                        {% elseif cluster.status == 'FAILED' %}
                            <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">
                                {{ cluster.status }}
                            </span>
                        {% elseif cluster.status == 'INACTIVE' %}
                            <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-900 dark:text-gray-300">
                                {{ cluster.status }}
                            </span>
                        {% elseif cluster.status %}
                            <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">
                                {{ cluster.status }}
                            </span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-container-instances">
                        {{ cluster.registeredContainerInstancesCount ?? '-' }}
                    </td>
                    <td class="px-6 py-4 column-running-tasks">
                        {{ cluster.runningTasksCount ?? '-' }}
                    </td>
                    <td class="px-6 py-4 column-active-services">
                        {{ cluster.activeServicesCount ?? '-' }}
                    </td>
                    <td class="px-6 py-4 column-cluster-arn">
                        <span class="text-xs text-gray-400 break-all">{{ cluster.clusterArn ?? '-' }}</span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                        Aucun cluster ECS trouvé
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="mt-5 flex justify-end">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
</turbo-frame>
