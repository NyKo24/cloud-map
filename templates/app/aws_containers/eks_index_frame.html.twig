<turbo-frame id="aws-eks-clusters-list-frame">
    <div class="mb-3 count text-black dark:text-white">
        {{ pagination.getTotalItemCount }} cluster(s) EKS trouvé(s)
    </div>

    <div class="mb-5">
        {% import '_macro/_table_columns_display.html.twig' as macro %}

        {% set columns = [
            { 'label': 'Name', 'cssClass': 'name', checked: true },
            { 'label': 'Status', 'cssClass': 'status', checked: true },
            { 'label': 'Version', 'cssClass': 'version', checked: true },
            { 'label': 'Platform Version', 'cssClass': 'platform-version', checked: true },
            { 'label': 'Endpoint', 'cssClass': 'endpoint', checked: true },
            { 'label': 'Role ARN', 'cssClass': 'role-arn', checked: false },
            { 'label': 'ARN', 'cssClass': 'arn', checked: false }
        ] %}

        {{ form_start(searchForm, {action: path(app.current_route)}) }}

        <div class="grid grid-cols-3 gap-4 items-end">
            {{ form_row(searchForm.name) }}
            {{ form_row(searchForm.status) }}
            {{ form_row(searchForm.version) }}
        </div>

        {% for key, value in app.request.query.all %}
            {% if searchForm[key] is not defined %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
        {% endfor %}

        <div class="flex gap-4 justify-between">
            <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                Rechercher
            </button>
            <div class="gap-4">
                {{ macro.dropdownTableColumsDisplay(columns) }}
                <a href="{{ path('app_aws_eks_clusters_list_export', app.request.query.all) }}" class="text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
                    Exporter
                </a>
            </div>
        </div>
        {{ form_end(searchForm) }}
    </div>

    <div class="relative overflow-x-auto">
        <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" class="px-6 py-3 column-name">{{ knp_pagination_sortable(pagination, 'Name', 'eks.name', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-status">{{ knp_pagination_sortable(pagination, 'Status', 'eks.status', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-version">{{ knp_pagination_sortable(pagination, 'Version', 'eks.version', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-platform-version">{{ knp_pagination_sortable(pagination, 'Platform Version', 'eks.platformVersion', [], app.request.query.all) }}</th>
                <th scope="col" class="px-6 py-3 column-endpoint">Endpoint</th>
                <th scope="col" class="px-6 py-3 column-role-arn">Role ARN</th>
                <th scope="col" class="px-6 py-3 column-arn">ARN</th>
            </tr>
            </thead>
            <tbody>
            {% for cluster in pagination %}
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 border-gray-200">
                    <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white column-name">
                        {{ cluster.name }}
                    </th>
                    <td class="px-6 py-4 column-status">
                        {% if cluster.status == 'ACTIVE' %}
                            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">
                                {{ cluster.status }}
                            </span>
                        {% elseif cluster.status == 'FAILED' %}
                            <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">
                                {{ cluster.status }}
                            </span>
                        {% elseif cluster.status %}
                            <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">
                                {{ cluster.status }}
                            </span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-version">
                        {% if cluster.version %}
                            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
                                {{ cluster.version }}
                            </span>
                        {% else %}
                            <span class="text-gray-400">-</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 column-platform-version">
                        {{ cluster.platformVersion ?? '-' }}
                    </td>
                    <td class="px-6 py-4 column-endpoint">
                        <span class="text-xs text-gray-400 break-all">{{ cluster.endpoint ?? '-' }}</span>
                    </td>
                    <td class="px-6 py-4 column-role-arn">
                        <span class="text-xs text-gray-400 break-all">{{ cluster.roleArn ?? '-' }}</span>
                    </td>
                    <td class="px-6 py-4 column-arn">
                        <span class="text-xs text-gray-400 break-all">{{ cluster.arn ?? '-' }}</span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                        Aucun cluster EKS trouvé
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="mt-5 flex justify-end">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
</turbo-frame>
