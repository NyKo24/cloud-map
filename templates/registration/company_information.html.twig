{% extends 'base_login.html.twig' %}

{% block title %}Company information{% endblock %}

{% block body %}
    <div class="bg-gray-50 dark:bg-gray-900 grid max-w-screen-xl min-w-screen min-h-screen px-4 py-8 mx-auto lg:gap-20 lg:py-16">
        <div class="w-full lg:col-span-6 flex items-center justify-center">
            <div class="p-6 mx-auto bg-white rounded-lg shadow dark:bg-gray-800 sm:max-w-xl sm:p-8">
                <div class="flex justify-center items-center">
                    <div class="inline-flex items-center mb-4 text-xl font-semibold text-gray-900 dark:text-white">
                        <img class="w-8 h-8 mr-2" src="{{ asset('assets/logo.svg') }}" alt="logo">
                        Resource Map
                    </div>
                </div>
                <ol class="flex items-center w-full text-sm font-medium text-center text-gray-500 dark:text-gray-400 sm:text-base mb-5">
                    <li class="flex md:w-full items-center text-blue-600 dark:text-blue-500 sm:after:content-[''] after:w-full after:h-1 after:border-b after:border-gray-200 after:border-1 after:hidden sm:after:inline-block after:mx-6 xl:after:mx-10 dark:after:border-gray-700">
                        <span class="flex items-center after:content-['/'] sm:after:hidden after:mx-2 after:text-gray-200 dark:after:text-gray-500">
                            <span class="me-2">1</span>
                            Information
                        </span>
                    </li>
                    <li class="flex md:w-full items-center after:content-[''] after:w-full after:h-1 after:border-b after:border-gray-200 after:border-1 after:hidden sm:after:inline-block after:mx-6 xl:after:mx-10 dark:after:border-gray-700">
                        <span class="flex items-center after:content-['/'] sm:after:hidden after:mx-2 after:text-gray-200 dark:after:text-gray-500">
                            <span class="me-2">2</span>
                            Configuration
                        </span>
                    </li>
                    <li class="flex items-center">
                        <span class="me-2">3</span>
                        Test
                    </li>
                </ol>
                    <h1 class="mb-2 text-2xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white">
                        Dites nous en plus sur votre entreprise
                    </h1>
                    <p class="text-sm font-light text-gray-500 dark:text-gray-300 mb-5">
                        Dans les prochaines étapes vous allez connecter vos comptes AWS et nous allons cartographier vos ressources. Mais avant, nous avons besoin de quelques informations sur votre entreprise.
                    </p>

                    {% for flash_error in app.flashes('verify_email_error') %}
                        <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
                            <span class="font-medium">{{ flash_error }}</span>
                        </div>
                    {% endfor %}

                    {{ form_errors(companyInformationForm) }}

                    {{ form_start(companyInformationForm, {attr: {class: 'mt-4 space-y-6 sm:mt-6'}}) }}
                    <div class="grid gap-3 sm:grid-cols-1">
                        {{ form_row(companyInformationForm.name) }}
                    </div>
                    <button type="submit" class="w-full text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700">Suivant</button>
                    {{ form_end(companyInformationForm) }}
                </div>
        </div>
    </div>
{% endblock %}